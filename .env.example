# Email delivery — Resend (preferred). Create an API key at resend.com.
# Once a domain is verified in Resend, set RESEND_FROM to a sender on it.
RESEND_API_KEY=
RESEND_FROM=Enigmo Labs Intake <onake@example.com>

# Fallback when RESEND_API_KEY is empty. For Gmail, SMTP_PASS must be a
# 16-character App Password (Google Account > Security > 2-Step Verification),
# not the account password.
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional overrides
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
TO_EMAIL=enigmolabs@gmail.com
APPLY_TO_EMAIL=
